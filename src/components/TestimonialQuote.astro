---
import Icon from './Icon.astro'

interface Props {
  name: string
  role: string
  company: string
  industry: string
  content: string
  initials: string
}

const { name, role, company, industry, content, initials }: Props = Astro.props
---

<article class="relative border-t border-border py-6 sm:py-8">
  <Icon name="quote" class="absolute right-0 top-6 h-8 w-8 text-primary/20 sm:top-8" />

  <blockquote class="relative z-10 mb-8 pr-8 text-foreground leading-relaxed">
    <p>"{content}"</p>
  </blockquote>

  <div class="flex items-center gap-4">
    <div
      class="flex h-12 w-12 shrink-0 items-center justify-center border border-border bg-secondary font-semibold text-primary"
      aria-hidden="true"
    >
      {initials}
    </div>
    <div>
      <h3 class="text-base font-semibold text-foreground">{name}</h3>
      <p class="text-sm text-muted-foreground">{role}, {company}</p>
    </div>
    <span class="ml-auto border border-border px-3 py-1 text-xs font-medium text-muted-foreground">
      {industry}
    </span>
  </div>
</article>
