---
import Icon from './Icon.astro'

interface Props {
  items: string[]
  class?: string
}

const { items, class: className = '' }: Props = Astro.props
---

<ul class:list={['grid gap-3 sm:grid-cols-2', className]}>
  {
    items.map((item) => (
      <li class="flex items-start gap-3 text-sm font-medium">
        <Icon name="check-circle-2" class="mt-0.5 h-5 w-5 shrink-0 text-primary" />
        <span>{item}</span>
      </li>
    ))
  }
</ul>
