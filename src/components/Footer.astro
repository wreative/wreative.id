---
import { Image } from 'astro:assets'
import Icon from './Icon.astro'

const currentYear = new Date().getFullYear()
---

<footer class="bg-background border-t border-border pt-16 pb-8">
  <div class="container-custom">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      <div class="lg:col-span-1">
        <a href="#home" class="inline-block mb-6 transition-opacity hover:opacity-80">
          <Image
            class="h-24 w-auto object-contain"
            src="https://avatars.githubusercontent.com/u/75348178?s=200&v=4"
            alt="Wreative Logo"
            width={200}
            height={200}
          />
        </a>
        <p class="text-muted-foreground text-sm max-w-[280px] leading-relaxed">
          Agensi digital spesialis pengembangan website dan aplikasi profesional untuk membantu
          skala bisnis Anda.
        </p>
      </div>

      <div>
        <h4 class="font-semibold mb-6">Navigasi</h4>
        <ul class="space-y-4 text-sm text-muted-foreground">
          <li><a href="#home" class="hover:text-primary transition-colors">Beranda</a></li>
          <li><a href="#services" class="hover:text-primary transition-colors">Layanan</a></li>
          <li><a href="#portfolio" class="hover:text-primary transition-colors">Portfolio</a></li>
          <li><a href="#why-us" class="hover:text-primary transition-colors">Mengapa Kami</a></li>
          <li><a href="#contact" class="hover:text-primary transition-colors">Kontak</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold mb-6">Link Terkait</h4>
        <ul class="space-y-4 text-sm text-muted-foreground">
          <li>
            <a
              href="https://link.wreative.com/portfolio"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1 hover:text-primary transition-colors group"
            >
              Lihat Portfolio
              <Icon
                name="arrow-up-right"
                class="h-3 w-3 opacity-50 group-hover:opacity-100 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 transition-transform"
              />
            </a>
          </li>
          <li>
            <a
              href="https://store.wreative.com"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1 hover:text-primary transition-colors group"
            >
              store.wreative.com
              <Icon
                name="arrow-up-right"
                class="h-3 w-3 opacity-50 group-hover:opacity-100 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 transition-transform"
              />
            </a>
          </li>
          <li>
            <a
              href="https://wreative.com"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1 hover:text-primary transition-colors group"
            >
              wreative.com
              <Icon
                name="arrow-up-right"
                class="h-3 w-3 opacity-50 group-hover:opacity-100 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 transition-transform"
              />
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="font-semibold mb-6">Sosial Media</h4>
        <div class="flex gap-4">
          <a
            href="https://www.linkedin.com/company/wreative"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full border border-border flex items-center justify-center text-muted-foreground hover:bg-primary hover:text-primary-foreground hover:border-primary transition-all hover:-translate-y-1"
          >
            <Icon name="linkedin" class="h-4 w-4" />
            <span class="sr-only">LinkedIn</span>
          </a>
          <a
            href="https://www.instagram.com/wreative"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full border border-border flex items-center justify-center text-muted-foreground hover:bg-primary hover:text-primary-foreground hover:border-primary transition-all hover:-translate-y-1"
          >
            <Icon name="instagram" class="h-4 w-4" />
            <span class="sr-only">Instagram</span>
          </a>
          <a
            href="https://youtube.com/@wreative"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full border border-border flex items-center justify-center text-muted-foreground hover:bg-primary hover:text-primary-foreground hover:border-primary transition-all hover:-translate-y-1"
          >
            <Icon name="youtube" class="h-4 w-4" />
            <span class="sr-only">YouTube</span>
          </a>
        </div>
      </div>
    </div>

    <div
      class="pt-8 border-t border-border flex flex-col items-center justify-center gap-2 text-sm text-muted-foreground text-center"
    >
      <p>&copy; {currentYear} PT. Wreative Digital Solutions Indonesia. Hak cipta dilindungi.</p>
      <p class="text-xs">NIB: 1204250004487 &middot; NPWP: 1000000001461492</p>
    </div>
  </div>
</footer>
