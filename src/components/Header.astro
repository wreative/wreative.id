---
import Button from './Button.astro'
import Icon from './Icon.astro'

const isHomePage = Astro.url.pathname === '/'
const homeSectionHref = (id: string) => `${isHomePage ? '' : '/'}#${id}`
const consultationHref = isHomePage ? '#contact' : 'https://link.wreative.com/wa'

const navLinks = [
  { name: 'Beranda', href: homeSectionHref('home') },
  { name: 'Layanan', href: homeSectionHref('services') },
  { name: 'Portfolio', href: homeSectionHref('portfolio') },
  { name: 'Mengapa Kami', href: homeSectionHref('why-us') },
  { name: 'Testimoni', href: homeSectionHref('testimonials') },
]
---

<header data-header class="fixed top-0 w-full z-50 border-b bg-transparent border-transparent py-5">
  <div class="container-custom flex items-center justify-between">
    <a href={homeSectionHref('home')} class="transition-opacity hover:opacity-80 flex items-center">
      <span class="text-2xl brand-text-premium">WREATIVE<span class="brand-dot">.</span></span>
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {
        navLinks.map((link) => (
          <a
            data-nav-link
            href={link.href}
            class="text-sm font-medium relative py-1 text-muted-foreground hover:text-primary"
          >
            {link.name}
          </a>
        ))
      }
      <Button
        as="a"
        href={consultationHref}
        target={isHomePage ? undefined : '_blank'}
        rel={isHomePage ? undefined : 'noopener noreferrer'}
        class="ml-4 font-medium btn-micro-anim"
      >
        Konsultasi Gratis
      </Button>
    </nav>

    <div class="md:hidden">
      <button
        data-menu-toggle
        data-menu-trigger
        type="button"
        aria-label="Menu"
        aria-controls="mobile-navigation"
        aria-expanded="false"
        class="inline-flex h-12 w-12 items-center justify-center border border-transparent text-foreground transition-colors hover:bg-secondary focus-visible:ring-2 focus-visible:ring-ring"
      >
        <Icon name="menu" class="h-5 w-5" />
      </button>
    </div>
  </div>
</header>

<div data-menu-overlay class="fixed inset-0 z-40 bg-black/50 md:hidden"></div>

<div
  data-menu
  id="mobile-navigation"
  aria-label="Navigasi seluler"
  aria-hidden="true"
  inert
  class="fixed inset-y-0 right-0 z-50 flex w-[min(22rem,100vw)] translate-x-full flex-col border-l border-border bg-background p-6"
>
  <button
    data-menu-toggle
    data-menu-close
    type="button"
    aria-label="Tutup menu"
    aria-controls="mobile-navigation"
    aria-expanded="false"
    class="absolute right-4 top-4 inline-flex h-12 w-12 items-center justify-center border border-transparent text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring"
  >
    <Icon name="x" class="h-5 w-5" />
  </button>
  <span class="sr-only">Menu Navigasi</span>

  <nav class="flex flex-col gap-6 mt-8">
    {
      navLinks.map((link) => (
        <a
          data-nav-link
          href={link.href}
          class="text-lg font-medium transition-colors text-foreground hover:text-primary"
        >
          {link.name}
        </a>
      ))
    }
  </nav>

  <div class="mt-auto mb-8">
    <Button
      as="a"
      href={consultationHref}
      target={isHomePage ? undefined : '_blank'}
      rel={isHomePage ? undefined : 'noopener noreferrer'}
      class="w-full justify-between btn-micro-anim"
    >
      Konsultasi Gratis
      <Icon name="arrow-right" class="h-4 w-4" />
    </Button>
  </div>
</div>

<script src="../scripts/main.js"></script>
