---
import Button from './Button.astro'
import Icon from './Icon.astro'

const navLinks = [
  { name: 'Beranda', href: '#home' },
  { name: 'Layanan', href: '#services' },
  { name: 'Portfolio', href: '#portfolio' },
  { name: 'Mengapa Kami', href: '#why-us' },
  { name: 'Testimoni', href: '#testimonials' },
]
---

<header
  data-header
  class="fixed top-0 w-full z-50 transition-all duration-300 border-b bg-transparent border-transparent py-5"
>
  <div class="container-custom flex items-center justify-between">
    <a href="#home" class="transition-opacity hover:opacity-80 flex items-center">
      <span class="text-2xl brand-text-premium">WREATIVE.</span>
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {
        navLinks.map((link) => (
          <a
            data-nav-link
            href={link.href}
            class="text-sm font-medium transition-all duration-200 relative py-1 text-muted-foreground hover:text-primary"
          >
            {link.name}
          </a>
        ))
      }
      <Button as="a" href="#contact" class="ml-4 font-medium btn-micro-anim">
        Konsultasi Gratis
      </Button>
    </nav>

    <div class="md:hidden">
      <button
        data-menu-toggle
        type="button"
        aria-label="Menu"
        class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 h-9 w-9 hover:bg-accent hover:text-accent-foreground"
      >
        <Icon name="menu" class="h-6 w-6" />
      </button>
    </div>
  </div>
</header>

<div data-menu-overlay class="fixed inset-0 z-40 bg-black/50 md:hidden"></div>

<div
  data-menu
  class="fixed inset-y-0 right-0 z-50 w-[300px] bg-background p-6 translate-x-full transition-transform duration-300 flex flex-col"
>
  <button
    data-menu-toggle
    type="button"
    aria-label="Close"
    class="absolute right-4 top-4 rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
  >
    <Icon name="x" class="h-4 w-4" />
    <span class="sr-only">Close</span>
  </button>
  <span class="sr-only">Menu Navigasi</span>

  <nav class="flex flex-col gap-6 mt-8">
    {
      navLinks.map((link) => (
        <a
          data-nav-link
          href={link.href}
          class="text-lg font-medium transition-colors text-foreground hover:text-primary"
        >
          {link.name}
        </a>
      ))
    }
  </nav>

  <div class="mt-auto mb-8">
    <Button as="a" href="#contact" class="w-full justify-between btn-micro-anim">
      Konsultasi Gratis
      <Icon name="arrow-right" class="h-4 w-4" />
    </Button>
  </div>
</div>
