---
import Icon from './Icon.astro'

interface Props {
  icon: string
  title: string
  description: string
  index: number
}

const { icon, title, description, index }: Props = Astro.props
---

<article
  class:list={[
    'flex gap-4 py-6 sm:px-6 sm:py-8',
    index > 0 && 'border-t border-border sm:border-l sm:border-t-0',
  ]}
>
  <span class="flex h-11 w-11 shrink-0 items-center justify-center bg-background text-primary">
    <Icon name={icon} class="h-5 w-5" />
  </span>
  <div>
    <h2 class="mb-1 text-base font-semibold">{title}</h2>
    <p class="text-sm text-muted-foreground">{description}</p>
  </div>
</article>
