---
import { Image } from 'astro:assets'
import Button from './Button.astro'
import FeatureList from './FeatureList.astro'
import Icon from './Icon.astro'

interface Props {
  service: {
    id: string
    icon: string
    title: string
    description: string
    items: string[]
    href?: string
    linkLabel?: string
    image?: { src: string; width: number; height: number; format: string }
  }
}
const { service } = Astro.props
---

<div id={service.id} class="scroll-m-32 border-t border-border pt-8">
  <div class="flex items-center gap-4 mb-6">
    <div class="w-12 h-12 rounded-xl bg-secondary flex items-center justify-center text-primary">
      <Icon name={service.icon} class="w-6 h-6" />
    </div>
    <h3 class="text-2xl m-0">{service.title}</h3>
  </div>

  <p class="text-lg text-muted-foreground mb-8 max-w-2xl leading-relaxed">
    {service.description}
  </p>

  <FeatureList items={service.items} class="mb-8 gap-4" />

  {
    service.href && (
      <Button as="a" href={service.href} variant="outline" class="mb-8 btn-micro-anim">
        {service.linkLabel}
      </Button>
    )
  }

  {
    service.image && (
      <div class="rounded-xl overflow-hidden border border-border bg-muted aspect-video relative group">
        <Image
          src={service.image}
          alt={`Ilustrasi ${service.title}`}
          width={1200}
          height={675}
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover"
        />
      </div>
    )
  }
</div>
