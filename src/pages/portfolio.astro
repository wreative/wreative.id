---
import Button from '../components/Button.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import Icon from '../components/Icon.astro'
import PwaHead from '../components/PwaHead.astro'
import '../index.css'

interface Item {
  slug: string
  title: string
  platform: 'website' | 'web-app' | 'mobile'
  category: string
  image: string
  url: string
  descriptionId: string
  tags: string[]
}

const res = await fetch('https://showcase.wreative.com/api/portfolio.json')
if (!res.ok) throw new Error(`Portfolio API failed: ${res.status}`)
const { data } = (await res.json()) as { data: Item[] }

const title = 'Portfolio Pembuatan Website & Aplikasi | Wreative'
const description = `${data.length} proyek website, aplikasi web, dan aplikasi mobile yang sudah kami kerjakan: company profile, e-commerce, edukasi, pemerintahan, dan layanan jasa.`
const ogImage = 'https://wreative.id/icons/og-image.png'
const canonical = 'https://wreative.id/portfolio'

const groups = [
  { id: 'website', heading: 'Website', items: data.filter((i) => i.platform === 'website') },
  { id: 'web-app', heading: 'Aplikasi Web', items: data.filter((i) => i.platform === 'web-app') },
  { id: 'mobile', heading: 'Aplikasi Mobile', items: data.filter((i) => i.platform === 'mobile') },
].filter((g) => g.items.length)

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: title,
      description,
      url: canonical,
      inLanguage: 'id-ID',
      isPartOf: { '@id': 'https://wreative.id/#website' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://wreative.id/' },
        { '@type': 'ListItem', position: 2, name: 'Portfolio', item: canonical },
      ],
    },
    {
      '@type': 'ItemList',
      numberOfItems: data.length,
      itemListElement: data.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'CreativeWork',
          name: item.title,
          description: item.descriptionId,
          image: item.image,
          url: item.url,
          genre: item.category,
          creator: { '@id': 'https://wreative.id/#organization' },
        },
      })),
    },
  ],
}
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <PwaHead />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="Wreative" />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-P1RLZGG7G8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        window.dataLayer.push(arguments)
      }
      gtag('js', new Date())
      gtag('config', 'G-P1RLZGG7G8')
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header />
    <main class="overflow-hidden">
      <section class="container-custom pb-12 pt-36 lg:pb-16 lg:pt-44">
        <div class="max-w-3xl">
          <h1 data-reveal class="mb-6">Portfolio Website & Aplikasi yang Sudah Kami Kerjakan</h1>
          <p data-reveal data-reveal-delay="100" class="text-lg text-muted-foreground">
            {description}
          </p>
        </div>
      </section>

      {
        groups.map((group) => (
          <section id={group.id} class="container-custom pb-16 lg:pb-24">
            <h2 data-reveal class="mb-8">
              {group.heading} <span class="text-muted-foreground">({group.items.length})</span>
            </h2>
            <ul class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
              {group.items.map((item) => (
                <li>
                  <article data-reveal>
                    <a
                      href={`https://showcase.wreative.com/id/project/${item.slug}/`}
                      class="group block"
                    >
                      <div class="mb-4 aspect-[16/10] overflow-hidden border border-border bg-muted">
                        <img
                          src={item.image}
                          alt={`Tampilan ${item.title}`}
                          loading="lazy"
                          decoding="async"
                          class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
                        />
                      </div>
                      <p class="mb-1 text-sm text-muted-foreground">{item.category}</p>
                      <h3 class="mb-2 text-xl group-hover:text-primary">{item.title}</h3>
                    </a>
                    <p class="mb-3 line-clamp-3 text-muted-foreground">{item.descriptionId}</p>
                    <p class="text-sm text-muted-foreground">{item.tags.join(' · ')}</p>
                  </article>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <section class="container-custom pb-20 lg:pb-28">
        <div class="bg-primary px-6 py-10 text-primary-foreground sm:px-10 sm:py-14 lg:px-16">
          <div class="flex flex-col gap-7 lg:flex-row lg:items-center lg:justify-between">
            <div data-reveal class="max-w-2xl">
              <h2 class="mb-3 text-3xl text-primary-foreground sm:text-4xl">
                Ingin proyek Anda tampil di sini?
              </h2>
              <p class="text-primary-foreground/80">
                Ceritakan kebutuhan Anda, kami bantu petakan solusinya.
              </p>
            </div>
            <Button
              as="a"
              href="https://link.wreative.com/wa"
              target="_blank"
              rel="noopener noreferrer"
              size="lg"
              variant="secondary"
              class="shrink-0 btn-micro-anim"
            >
              <Icon name="message-circle" class="h-5 w-5" />
              Konsultasi Gratis
            </Button>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
