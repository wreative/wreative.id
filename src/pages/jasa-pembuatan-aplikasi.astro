---
import { Image } from 'astro:assets'
import Button from '../components/Button.astro'
import BenefitItem from '../components/BenefitItem.astro'
import FeatureList from '../components/FeatureList.astro'
import FAQItem from '../components/FAQItem.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import Icon from '../components/Icon.astro'
import ProcessStep from '../components/ProcessStep.astro'
import PwaHead from '../components/PwaHead.astro'
import mobileApp from '../assets/images/mobile-app.webp'
import webApplication from '../assets/images/web-application.webp'
import '../index.css'

const title = 'Jasa Pembuatan Aplikasi Mobile & Web | Wreative'
const description =
  'Jasa pembuatan aplikasi Android, iOS, dan web application untuk membantu bisnis mengembangkan layanan dan mengotomatisasi proses.'
const ogImage = 'https://wreative.id/icons/og-image.png'
const canonical = 'https://wreative.id/jasa-pembuatan-aplikasi'

const benefits = [
  {
    icon: 'smartphone',
    title: 'Pengalaman yang mudah digunakan',
    description: 'Antarmuka dirancang dengan memperhatikan kebutuhan pengguna.',
  },
  {
    icon: 'code-2',
    title: 'Clean code',
    description: 'Struktur kode yang rapi dan mudah di-maintain.',
  },
  {
    icon: 'wrench',
    title: 'Dukungan pasca rilis',
    description: 'Tersedia maintenance untuk mendukung aplikasi setelah diluncurkan.',
  },
]

const process = [
  {
    number: '01',
    title: 'Diskusi kebutuhan',
    description: 'Bahas tujuan dan kebutuhan bisnis Anda.',
  },
  {
    number: '02',
    title: 'Perencanaan & desain',
    description: 'Susun ruang lingkup dan rancangan UI/UX.',
  },
  {
    number: '03',
    title: 'Development & testing',
    description: 'Bangun fitur yang disepakati dan lakukan pengujian.',
  },
  {
    number: '04',
    title: 'Launching',
    description: 'Siapkan aplikasi untuk dirilis ke platform yang dituju.',
  },
]

const faqs = [
  {
    question: 'Aplikasi apa saja yang dikembangkan Wreative?',
    answer:
      'Kami mengembangkan aplikasi mobile untuk Android dan iOS, serta web application seperti dashboard, SaaS, ERP/CRM, dan sistem manajemen.',
  },
  {
    question: 'Teknologi apa yang digunakan untuk membuat aplikasi?',
    answer:
      'Aplikasi mobile dapat dikembangkan menggunakan Flutter untuk Android dan iOS. Teknologi untuk web application dibahas berdasarkan kebutuhan dan ruang lingkup proyek.',
  },
  {
    question: 'Berapa biaya pembuatan aplikasi?',
    answer:
      'Biaya menyesuaikan fitur, platform, dan ruang lingkup proyek. Hubungi tim Wreative untuk konsultasi gratis dan pembahasan kebutuhan Anda.',
  },
  {
    question: 'Apakah ada maintenance setelah aplikasi diluncurkan?',
    answer:
      'Ya. Dukungan maintenance pasca rilis tersedia untuk perbaikan bug, pembaruan keamanan, dan pengembangan fitur lanjutan sesuai kebutuhan.',
  },
]
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Service', name: 'Jasa Pembuatan Aplikasi', serviceType: 'Pengembangan aplikasi mobile dan web', description, url: canonical, inLanguage: 'id-ID', areaServed: { '@type': 'Country', name: 'Indonesia' }, provider: { '@type': 'Organization', '@id': 'https://wreative.id/#organization', name: 'Wreative', url: 'https://wreative.id' } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://wreative.id/' },
      { '@type': 'ListItem', position: 2, name: 'Jasa Pembuatan Aplikasi', item: canonical },
    ] },
    { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) },
  ],
}
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <PwaHead />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="Wreative" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:locale" content="id_ID" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-P1RLZGG7G8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        window.dataLayer.push(arguments)
      }
      gtag('js', new Date())
      gtag('config', 'G-P1RLZGG7G8')
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header />
    <main class="overflow-hidden">
      <section class="container-custom pb-20 pt-36 lg:pb-28 lg:pt-44">
        <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
          <div class="max-w-2xl">
            <h1 data-reveal class="mb-6">Jasa Pembuatan Aplikasi Mobile dan Web untuk Bisnis</h1>
            <p
              data-reveal
              data-reveal-delay="100"
              class="mb-8 max-w-xl text-lg text-muted-foreground"
            >
              Solusi aplikasi yang dibangun sesuai kebutuhan, dari aplikasi Android dan iOS hingga
              web application untuk mendukung proses bisnis.
            </p>
            <div data-reveal data-reveal-delay="180" class="flex flex-col gap-3 sm:flex-row">
              <Button
                as="a"
                href="https://link.wreative.com/wa"
                target="_blank"
                rel="noopener noreferrer"
                size="lg"
                class="btn-micro-anim"
              >
                <Icon name="message-circle" class="h-5 w-5" />
                Diskusikan Proyek via WhatsApp
              </Button>
              <a
                href="#jenis-aplikasi"
                class="inline-flex h-12 min-h-12 items-center justify-center gap-2 border border-input bg-background px-6 text-sm font-medium transition-colors hover:bg-primary hover:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
              >
                Lihat kapabilitas
                <Icon name="chevron-down" class="h-4 w-4" />
              </a>
            </div>
          </div>

          <div class="relative mx-auto w-full max-w-xl lg:pl-4">
            <div class="relative grid grid-cols-[0.8fr_1.2fr] items-center gap-3 sm:gap-4">
              <div
                data-reveal
                data-reveal-delay="100"
                class="relative z-10 -mr-7 overflow-hidden border-4 border-background bg-secondary sm:-mr-10"
              >
                <Image
                  src={mobileApp}
                  alt="Contoh tampilan aplikasi mobile"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  class="aspect-[3/4] w-full object-cover"
                />
                <div
                  class="absolute bottom-3 left-3 right-3 bg-background px-3 py-2 text-xs font-semibold"
                >
                  Aplikasi mobile
                </div>
              </div>
              <div
                data-reveal
                data-reveal-delay="180"
                class="overflow-hidden border border-border bg-secondary p-2 sm:p-3"
              >
                <Image
                  src={webApplication}
                  alt="Tampilan dashboard web application"
                  loading="eager"
                  decoding="async"
                  class="aspect-[4/3] w-full object-cover"
                />
                <p
                  class="px-2 pb-1 pt-3 text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground"
                >
                  Web application
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section
        aria-label="Keunggulan pengembangan aplikasi"
        class="border-y border-border bg-secondary/50"
      >
        <div class="container-custom grid gap-0 sm:grid-cols-3">
          {benefits.map((benefit, index) => <BenefitItem {...benefit} index={index} />)}
        </div>
      </section>

      <section id="jenis-aplikasi" class="container-custom section-padding scroll-m-24">
        <div class="mb-12 grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <h2 data-reveal class="max-w-2xl">Aplikasi yang mendukung cara bisnis Anda bekerja</h2>
          </div>
          <p data-reveal data-reveal-delay="80" class="text-muted-foreground lg:col-span-5 lg:pb-1">
            Pilih platform dan fitur sesuai kebutuhan pengguna dan proses bisnis Anda.
          </p>
        </div>
        <div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
          <article
            data-reveal
            aria-labelledby="mobile-capability-title"
            class="border-t border-border pt-7"
          >
            <div class="mb-6 flex items-center gap-4">
              <span
                class="flex h-12 w-12 shrink-0 items-center justify-center bg-secondary text-primary"
              >
                <Icon name="smartphone" class="h-6 w-6" />
              </span>
              <div>
                <h3 id="mobile-capability-title">Aplikasi mobile</h3>
                <p class="mt-1 text-sm text-muted-foreground">Android & iOS</p>
              </div>
            </div>
            <p class="mb-6 text-muted-foreground">
              Jangkau pelanggan melalui aplikasi mobile yang user-friendly, dirancang untuk
              kebutuhan perangkat Android dan iOS.
            </p>
            <FeatureList
              items={[
                'Aplikasi Android & iOS',
                'Pengembangan dengan Flutter',
                'Siap publish ke Play Store',
                'Siap publish ke App Store',
              ]}
            />
          </article>

          <article
            data-reveal
            data-reveal-delay="80"
            aria-labelledby="web-capability-title"
            class="border-t border-border pt-7"
          >
            <div class="mb-6 flex items-center gap-4">
              <span
                class="flex h-12 w-12 shrink-0 items-center justify-center bg-secondary text-primary"
              >
                <Icon name="layout" class="h-6 w-6" />
              </span>
              <div>
                <h3 id="web-capability-title">Web application</h3>
                <p class="mt-1 text-sm text-muted-foreground">Sistem berbasis web</p>
              </div>
            </div>
            <p class="mb-6 text-muted-foreground">
              Otomatisasi proses bisnis melalui aplikasi web kustom dengan fitur yang disesuaikan
              dengan alur kerja.
            </p>
            <FeatureList
              items={[
                'Dashboard analitik',
                'Aplikasi SaaS',
                'Sistem ERP & CRM',
                'Sistem manajemen',
              ]}
            />
          </article>
        </div>
      </section>

      <section class="section-padding border-y border-border bg-secondary/50">
        <div class="container-custom">
          <div data-reveal class="mx-auto mb-12 max-w-2xl text-center">
            <h2 class="mb-4">Dari kebutuhan hingga aplikasi siap dirilis</h2>
            <p class="text-muted-foreground">
              Proses dimulai dengan memahami kebutuhan dan ruang lingkup proyek Anda.
            </p>
          </div>
          <ol class="grid gap-x-6 sm:grid-cols-2 lg:grid-cols-4">
            {process.map((step, index) => <ProcessStep {...step} index={index} />)}
          </ol>
        </div>
      </section>

      <section id="faq" class="container-custom section-padding">
        <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-12 lg:gap-16">
          <div data-reveal class="lg:col-span-4">
            <h2 class="mb-4">Pertanyaan seputar pembuatan aplikasi</h2>
            <p class="text-muted-foreground">
              Punya pertanyaan lain? Diskusikan langsung dengan tim Wreative.
            </p>
          </div>
          <div class="border-t border-border lg:col-span-8">
            {
              faqs.map((faq, index) => (
                <FAQItem question={faq.question} answer={faq.answer} index={index} />
              ))
            }
          </div>
        </div>
      </section>

      <section class="container-custom pb-20 lg:pb-28">
        <div
          class="relative overflow-hidden bg-primary px-6 py-10 text-primary-foreground sm:px-10 sm:py-14 lg:px-16"
        >
          <div class="relative flex flex-col gap-7 lg:flex-row lg:items-center lg:justify-between">
            <div data-reveal class="max-w-2xl">
              <h2 class="mb-3 text-3xl text-primary-foreground sm:text-4xl">
                Punya rencana membuat aplikasi?
              </h2>
              <p class="text-primary-foreground/80">
                Ceritakan kebutuhan mobile atau web application bisnis Anda kepada tim Wreative.
              </p>
            </div>
            <Button
              as="a"
              href="https://link.wreative.com/wa"
              target="_blank"
              rel="noopener noreferrer"
              size="lg"
              variant="secondary"
              data-reveal
              data-reveal-delay="120"
              class="shrink-0 btn-micro-anim"
            >
              <Icon name="message-circle" class="h-5 w-5" />
              Konsultasi Gratis
            </Button>
          </div>
        </div>
        <p class="mt-8 text-center text-sm text-muted-foreground">
          Sedang mencari website bisnis? Lihat{' '}
          <a
            href="/jasa-pembuatan-website"
            class="font-semibold text-foreground underline decoration-border underline-offset-4 transition-colors hover:text-primary"
          >
            jasa pembuatan website
          </a>.
        </p>
      </section>
    </main>
    <Footer />
  </body>
</html>
