---
import Button from '../components/Button.astro'
import '../index.css'
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-P1RLZGG7G8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        window.dataLayer.push(arguments)
      }
      gtag('js', new Date())
      gtag('config', 'G-P1RLZGG7G8')
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#DFE4EA" />
    <title>404 — Halaman Tidak Ditemukan | Wreative</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="container-custom flex items-center py-7">
        <a href="/" class="brand-text-premium text-2xl" aria-label="Wreative — kembali ke beranda">
          WREATIVE<span class="brand-dot">.</span>
        </a>
      </header>

      <main class="container-custom flex flex-1 items-center py-12">
        <section
          class="mx-auto grid w-full max-w-6xl items-center gap-12 lg:grid-cols-2 lg:gap-16"
          aria-labelledby="error-title"
        >
          <div class="relative z-10 max-w-xl">
            <h1 data-reveal id="error-title" class="mb-5">Halaman tidak ditemukan</h1>
            <p
              data-reveal
              data-reveal-delay="100"
              class="mb-8 max-w-lg text-lg text-muted-foreground"
            >
              Sepertinya tautannya kurang tepat atau halaman ini sudah dipindahkan. Mari bantu Anda
              kembali ke jalur yang benar.
            </p>
            <div data-reveal data-reveal-delay="180" class="flex flex-col gap-3 sm:flex-row">
              <Button as="a" href="/" size="lg" class="btn-micro-anim"> Kembali ke Beranda </Button>
              <Button as="a" href="/#services" variant="outline" size="lg" class="btn-micro-anim">
                Lihat Layanan
              </Button>
            </div>
          </div>

          <div
            data-reveal
            class="error-art relative mx-auto flex aspect-square w-full max-w-md items-center justify-center"
          >
            <div
              class="error-card relative flex h-64 w-64 flex-col items-center justify-center sm:h-72 sm:w-72"
            >
              <span class="error-card-label">PAGE NOT FOUND</span>
              <span class="error-card-code" aria-hidden="true">404</span>
              <span class="error-card-dot" aria-hidden="true"></span>
            </div>
          </div>
        </section>
      </main>

      <footer class="container-custom py-6 text-center text-sm text-muted-foreground">
        &copy; {new Date().getFullYear()} Wreative. All rights reserved.
      </footer>
    </div>
    <script src="../scripts/main.js"></script>
  </body>
</html>

<style>
  .page-shell {
    display: flex;
    min-height: 100vh;
    flex-direction: column;
    overflow: hidden;
    background: hsl(var(--background));
  }

  .error-art {
    isolation: isolate;
  }

  .error-card {
    z-index: 1;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--background));
  }

  .error-card-label {
    color: hsl(var(--muted-foreground));
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.2em;
  }

  .error-card-code {
    color: #3a455c;
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(3.75rem, 12vw, 6.25rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    padding-right: 0.1em;
  }

  .error-card-dot {
    position: absolute;
    right: 23%;
    bottom: 26%;
    width: 0.7rem;
    height: 0.7rem;
    background: #eb5250;
  }
</style>
