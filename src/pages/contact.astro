---
import Button from '../components/Button.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import Icon from '../components/Icon.astro'
import PwaHead from '../components/PwaHead.astro'
import '../index.css'

const title = 'Kontak Wreative | Konsultasi Website & Aplikasi'
const description =
  'Hubungi Wreative untuk konsultasi gratis pembuatan website dan aplikasi mobile melalui WhatsApp.'
const ogImage = 'https://wreative.id/icons/og-image.png'
const canonical = 'https://wreative.id/contact'
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'ContactPage', name: title, description, url: canonical, inLanguage: 'id-ID', about: { '@type': 'Organization', '@id': 'https://wreative.id/#organization', name: 'Wreative', url: 'https://wreative.id' } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://wreative.id/' },
      { '@type': 'ListItem', position: 2, name: 'Kontak', item: canonical },
    ] },
  ],
}
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-P1RLZGG7G8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        window.dataLayer.push(arguments)
      }
      gtag('js', new Date())
      gtag('config', 'G-P1RLZGG7G8')
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <PwaHead />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="Wreative" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header />
    <main class="min-h-[65vh]">
      <section class="container-custom pt-36 pb-24 lg:pt-44 lg:pb-32">
        <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2 lg:gap-20">
          <div data-reveal class="max-w-xl">
            <h1 class="mb-6">Mari mulai percakapan.</h1>
            <p data-reveal data-reveal-delay="100" class="mb-8 text-lg text-muted-foreground">
              Ceritakan kebutuhan website atau aplikasi bisnis Anda. Tim Wreative siap membantu
              mendiskusikan solusi yang tepat untuk ide Anda.
            </p>

            <div class="border-t border-border pt-6">
              <h2 class="mb-4 text-base font-semibold">Temukan kami di media sosial</h2>
              <ul class="flex flex-wrap gap-x-6 gap-y-3 text-sm font-medium">
                <li>
                  <a
                    href="https://www.linkedin.com/company/wreative"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-muted-foreground transition-colors hover:text-primary"
                  >
                    LinkedIn
                  </a>
                </li>
                <li>
                  <a
                    href="https://www.instagram.com/wreative"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-muted-foreground transition-colors hover:text-primary"
                  >
                    Instagram
                  </a>
                </li>
                <li>
                  <a
                    href="https://www.tiktok.com/@wreative"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-muted-foreground transition-colors hover:text-primary"
                  >
                    TikTok
                  </a>
                </li>
              </ul>
            </div>
          </div>

          <aside
            aria-labelledby="consultation-title"
            data-reveal
            data-reveal-delay="140"
            class="border border-border bg-secondary/50 p-8 sm:p-10"
          >
            <div class="mb-6 flex h-12 w-12 items-center justify-center bg-background text-primary">
              <Icon name="message-circle" class="h-6 w-6" />
            </div>
            <h2 id="consultation-title" class="mb-4 text-2xl">Hubungi kami via WhatsApp</h2>
            <p class="-mt-2 mb-4 text-sm font-semibold text-muted-foreground">Konsultasi gratis</p>
            <p class="mb-8 text-muted-foreground">
              Klik tombol di bawah untuk membuka percakapan WhatsApp dengan tim Wreative.
            </p>
            <Button
              as="a"
              href="https://link.wreative.com/wa"
              target="_blank"
              rel="noopener noreferrer"
              size="lg"
              class="w-full btn-micro-anim"
            >
              <Icon name="message-circle" class="h-5 w-5" />
              Mulai Konsultasi
            </Button>
          </aside>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
