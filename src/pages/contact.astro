---
import Button from '../components/Button.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import Icon from '../components/Icon.astro'
import '../index.css'

const title = 'Kontak Wreative | Konsultasi Website & Aplikasi'
const description =
  'Hubungi Wreative untuk konsultasi gratis pembuatan website dan aplikasi mobile melalui WhatsApp.'
const canonical = 'https://wreative.id/contact'
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-P1RLZGG7G8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        window.dataLayer.push(arguments)
      }
      gtag('js', new Date())
      gtag('config', 'G-P1RLZGG7G8')
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <Header />
    <main class="min-h-[65vh]">
      <section class="container-custom pt-36 pb-24 lg:pt-44 lg:pb-32">
        <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2 lg:gap-20">
          <div class="max-w-xl">
            <p
              class="mb-5 inline-flex items-center gap-2 rounded-full border border-border bg-secondary/50 px-3 py-1 text-sm font-medium text-muted-foreground"
            >
              <span class="h-2 w-2 rounded-full bg-[#eb5250]" aria-hidden="true"></span>
              Hubungi Wreative
            </p>
            <h1 class="mb-6">Mari mulai percakapan.</h1>
            <p class="mb-8 text-lg text-muted-foreground">
              Ceritakan kebutuhan website atau aplikasi bisnis Anda. Tim Wreative siap membantu
              mendiskusikan solusi yang tepat untuk ide Anda.
            </p>

            <div class="border-t border-border pt-6">
              <h2 class="mb-4 text-base font-semibold">Temukan kami di media sosial</h2>
              <ul class="flex flex-wrap gap-x-6 gap-y-3 text-sm font-medium">
                <li>
                  <a
                    href="https://www.linkedin.com/company/wreative"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-muted-foreground transition-colors hover:text-primary"
                  >
                    LinkedIn
                  </a>
                </li>
                <li>
                  <a
                    href="https://www.instagram.com/wreative"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-muted-foreground transition-colors hover:text-primary"
                  >
                    Instagram
                  </a>
                </li>
                <li>
                  <a
                    href="https://www.tiktok.com/@wreative"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-muted-foreground transition-colors hover:text-primary"
                  >
                    TikTok
                  </a>
                </li>
              </ul>
            </div>
          </div>

          <aside
            aria-labelledby="consultation-title"
            class="rounded-2xl border border-border bg-secondary/50 p-8 premium-shadow sm:p-10"
          >
            <div
              class="mb-6 flex h-12 w-12 items-center justify-center rounded-full bg-background text-primary"
            >
              <Icon name="message-circle" class="h-6 w-6" />
            </div>
            <p class="mb-2 text-sm font-semibold text-muted-foreground">Konsultasi gratis</p>
            <h2 id="consultation-title" class="mb-4 text-2xl">Hubungi kami via WhatsApp</h2>
            <p class="mb-8 text-muted-foreground">
              Klik tombol di bawah untuk membuka percakapan WhatsApp dengan tim Wreative.
            </p>
            <Button
              as="a"
              href="https://link.wreative.com/wa"
              target="_blank"
              rel="noopener noreferrer"
              size="lg"
              class="w-full btn-micro-anim"
            >
              <Icon name="message-circle" class="h-5 w-5" />
              Mulai Konsultasi
            </Button>
          </aside>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
