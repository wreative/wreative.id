---
import { Image } from 'astro:assets'
import Button from '../components/Button.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import Icon from '../components/Icon.astro'
import bangunWebsite from '../assets/images/bangun-website.webp'
import '../index.css'

const title = 'Jasa Pembuatan Website Profesional | Wreative'
const description =
  'Jasa pembuatan website profesional untuk bisnis: company profile, landing page, custom website, dan sistem internal yang cepat dan responsif.'
const canonical = 'https://wreative.id/jasa-pembuatan-website'

const benefits = [
  {
    icon: 'smartphone',
    title: 'Responsif di berbagai layar',
    description: 'Tampilan menyesuaikan perangkat desktop maupun ponsel.',
  },
  {
    icon: 'zap',
    title: 'Performa yang diperhatikan',
    description: 'Optimasi kecepatan muat untuk pengalaman yang lebih baik.',
  },
  {
    icon: 'globe',
    title: 'Fondasi SEO',
    description: 'Struktur HTML semantik yang mengikuti praktik SEO.',
  },
]

const offerings = [
  {
    number: '01',
    title: 'Company Profile',
    description: 'Perkenalkan profil, layanan, dan informasi bisnis Anda secara profesional.',
    icon: 'globe',
  },
  {
    number: '02',
    title: 'Landing Page',
    description: 'Halaman terarah untuk menyampaikan penawaran atau kebutuhan promosi.',
    icon: 'layout',
  },
  {
    number: '03',
    title: 'Custom Website',
    description: 'Website dengan desain dan fitur yang disesuaikan dengan kebutuhan bisnis.',
    icon: 'code-2',
  },
  {
    number: '04',
    title: 'Sistem internal',
    description: 'Sistem berbasis web untuk mendukung proses dan pengelolaan internal.',
    icon: 'layout',
  },
]

const process = [
  {
    number: '01',
    title: 'Diskusi kebutuhan',
    description: 'Bahas tujuan dan kebutuhan bisnis Anda.',
  },
  {
    number: '02',
    title: 'Perencanaan & desain',
    description: 'Susun ruang lingkup dan rancangan UI/UX.',
  },
  {
    number: '03',
    title: 'Development & testing',
    description: 'Bangun fitur yang disepakati dan lakukan pengujian.',
  },
  {
    number: '04',
    title: 'Launching',
    description: 'Siapkan website untuk dirilis ke lingkungan produksi.',
  },
]

const faqs = [
  {
    question: 'Berapa biaya jasa pembuatan website?',
    answer:
      'Biaya menyesuaikan jenis website, fitur, dan ruang lingkup proyek. Ceritakan kebutuhan Anda melalui konsultasi gratis untuk mendapatkan pembahasan dan penawaran yang sesuai.',
  },
  {
    question: 'Berapa lama proses pembuatan website?',
    answer:
      'Waktu pengerjaan bergantung pada ruang lingkup dan fitur yang dibutuhkan. Timeline dibahas setelah kebutuhan proyek dipetakan.',
  },
  {
    question: 'Apakah website dibuat dengan memperhatikan SEO?',
    answer:
      'Website dibuat dengan struktur HTML semantik, desain responsif, dan perhatian pada performa sebagai fondasi SEO.',
  },
  {
    question: 'Apakah tersedia maintenance setelah website dirilis?',
    answer:
      'Ya. Dukungan maintenance pasca rilis tersedia untuk perbaikan bug, pembaruan keamanan, dan pengembangan fitur lanjutan sesuai kebutuhan.',
  },
]
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="id_ID" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-P1RLZGG7G8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        window.dataLayer.push(arguments)
      }
      gtag('js', new Date())
      gtag('config', 'G-P1RLZGG7G8')
    </script>
  </head>
  <body>
    <Header />
    <main class="overflow-hidden">
      <section class="container-custom pb-20 pt-36 lg:pb-28 lg:pt-44">
        <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
          <div class="max-w-2xl">
            <p
              class="mb-5 inline-flex items-center gap-2 rounded-full border border-border bg-secondary/60 px-3 py-1 text-sm font-medium text-muted-foreground"
            >
              <span class="h-2 w-2 rounded-full bg-[#eb5250]" aria-hidden="true"></span>
              Jasa Pembuatan Website
            </p>
            <h1 class="mb-6 text-4xl sm:text-5xl">
              Jasa Pembuatan Website Profesional untuk Bisnis Anda
            </h1>
            <p class="mb-8 max-w-xl text-lg text-muted-foreground">
              Website yang cepat, responsif, dan sesuai kebutuhan bisnis, mulai dari company profile
              hingga sistem internal.
            </p>
            <div class="flex flex-col gap-3 sm:flex-row">
              <Button
                as="a"
                href="https://link.wreative.com/wa"
                target="_blank"
                rel="noopener noreferrer"
                size="lg"
                class="btn-micro-anim"
              >
                <Icon name="message-circle" class="h-5 w-5" />
                Konsultasi via WhatsApp
              </Button>
              <a
                href="#layanan"
                class="inline-flex h-10 items-center justify-center gap-2 rounded-md border border-input bg-background px-6 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
              >
                Lihat layanan
                <Icon name="chevron-down" class="h-4 w-4" />
              </a>
            </div>
          </div>

          <div class="relative mx-auto w-full max-w-xl lg:pl-4">
            <div
              class="absolute -left-2 top-8 h-32 w-32 rounded-full bg-primary/5 blur-3xl"
              aria-hidden="true"
            >
            </div>
            <div
              class="relative overflow-hidden rounded-2xl border border-border bg-secondary/50 p-3 premium-shadow sm:p-4"
            >
              <Image
                src={bangunWebsite}
                alt="Kolaborasi dalam proses pengembangan website bisnis"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="aspect-[4/3] w-full rounded-xl object-cover"
              />
              <div
                class="absolute bottom-7 left-7 rounded-xl border border-border/70 bg-background/95 p-4 shadow-lg backdrop-blur-sm sm:bottom-8 sm:left-8"
              >
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground">
                  Dari ide hingga rilis
                </p>
                <p class="mt-1 text-sm font-semibold">Website untuk kebutuhan bisnis Anda</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section aria-label="Keunggulan website" class="border-y border-border bg-secondary/50">
        <div class="container-custom grid gap-0 sm:grid-cols-3">
          {
            benefits.map((benefit, index) => (
              <article
                class:list={[
                  'flex gap-4 py-7 sm:px-6 sm:py-8',
                  index > 0 && 'border-t border-border sm:border-l sm:border-t-0',
                ]}
              >
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-background text-primary">
                  <Icon name={benefit.icon} class="h-5 w-5" />
                </span>
                <div>
                  <h2 class="mb-1 text-base font-semibold">{benefit.title}</h2>
                  <p class="text-sm text-muted-foreground">{benefit.description}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section id="layanan" class="container-custom section-padding scroll-m-24">
        <div class="mb-12 grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7">
            <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-primary">
              Pilihan layanan
            </p>
            <h2 class="max-w-2xl">Website yang dirancang sesuai kebutuhan bisnis</h2>
          </div>
          <p class="text-muted-foreground lg:col-span-5 lg:pb-1">
            Mulai dari memperkenalkan usaha hingga mendukung proses kerja melalui sistem berbasis
            web.
          </p>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          {
            offerings.map((offering) => (
              <article class="group rounded-2xl border border-border bg-background p-6 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:premium-shadow-hover sm:p-8">
                <div class="mb-8 flex items-center justify-between">
                  <span class="text-sm font-semibold tracking-widest text-muted-foreground">
                    {offering.number}
                  </span>
                  <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-secondary text-primary transition-colors group-hover:bg-primary group-hover:text-primary-foreground">
                    <Icon name={offering.icon} class="h-6 w-6" />
                  </span>
                </div>
                <h3 class="mb-3">{offering.title}</h3>
                <p class="max-w-lg text-muted-foreground">{offering.description}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section-padding border-y border-border bg-secondary/50">
        <div class="container-custom">
          <div class="mx-auto mb-12 max-w-2xl text-center">
            <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-primary">
              Cara kerja
            </p>
            <h2 class="mb-4">Langkah jelas menuju website Anda</h2>
            <p class="text-muted-foreground">
              Setiap tahap dimulai dari pemahaman kebutuhan dan ruang lingkup yang disepakati.
            </p>
          </div>
          <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {
              process.map((step) => (
                <li class="relative rounded-2xl border border-border bg-background p-6">
                  <span class="mb-6 inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary text-sm font-semibold text-primary-foreground">
                    {step.number}
                  </span>
                  <h3 class="mb-2 text-lg">{step.title}</h3>
                  <p class="text-sm text-muted-foreground">{step.description}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section id="faq" class="container-custom section-padding">
        <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4">
            <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-primary">FAQ</p>
            <h2 class="mb-4">Pertanyaan seputar pembuatan website</h2>
            <p class="text-muted-foreground">
              Belum menemukan jawaban? Ceritakan kebutuhan Anda, kami siap membantu membahasnya.
            </p>
          </div>
          <div class="space-y-3 lg:col-span-8">
            {
              faqs.map((faq) => (
                <details class="group rounded-xl border border-border bg-background p-5 open:bg-secondary/40 sm:p-6">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold marker:content-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                    {faq.question}
                    <Icon
                      name="chevron-down"
                      class="h-5 w-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180"
                    />
                  </summary>
                  <p class="mt-4 max-w-3xl pr-8 text-muted-foreground">{faq.answer}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <section class="container-custom pb-20 lg:pb-28">
        <div
          class="relative overflow-hidden rounded-2xl bg-primary px-6 py-10 text-primary-foreground sm:px-10 sm:py-14 lg:px-16"
        >
          <div
            class="absolute -right-12 -top-20 h-64 w-64 rounded-full border border-primary-foreground/10"
            aria-hidden="true"
          >
          </div>
          <div
            class="absolute -right-2 -top-10 h-44 w-44 rounded-full border border-primary-foreground/10"
            aria-hidden="true"
          >
          </div>
          <div class="relative flex flex-col gap-7 lg:flex-row lg:items-center lg:justify-between">
            <div class="max-w-2xl">
              <p
                class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-primary-foreground/70"
              >
                Mulai dari percakapan
              </p>
              <h2 class="mb-3 text-3xl text-primary-foreground sm:text-4xl">
                Punya rencana membuat website?
              </h2>
              <p class="text-primary-foreground/80">
                Diskusikan kebutuhan bisnis Anda bersama tim Wreative.
              </p>
            </div>
            <Button
              as="a"
              href="https://link.wreative.com/wa"
              target="_blank"
              rel="noopener noreferrer"
              size="lg"
              variant="secondary"
              class="shrink-0 btn-micro-anim"
            >
              <Icon name="message-circle" class="h-5 w-5" />
              Konsultasi Gratis
            </Button>
          </div>
        </div>
        <p class="mt-8 text-center text-sm text-muted-foreground">
          Butuh aplikasi mobile atau web? Lihat
          <a
            href="/jasa-pembuatan-aplikasi"
            class="font-semibold text-foreground underline decoration-border underline-offset-4 transition-colors hover:text-primary"
          >
            jasa pembuatan aplikasi
          </a>.
        </p>
      </section>
    </main>
    <Footer />
    <script src="../scripts/main.js"></script>
  </body>
</html>
